<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="150.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hospital.ChangePasswordController">
   <children>
      <Label layoutX="14.0" layoutY="7.0" text="Zmień hasło">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <PasswordField fx:id="oldPassword" layoutX="14.0" layoutY="67.0" />
      <PasswordField fx:id="newPassword" layoutX="226.0" layoutY="67.0" />
      <PasswordField fx:id="newPassword2" layoutX="437.0" layoutY="67.0" />
      <Label layoutX="14.0" layoutY="50.0" text="Stare hasło" />
      <Label layoutX="226.0" layoutY="50.0" text="Nowe hasło" />
      <Label layoutX="437.0" layoutY="50.0" text="Powtórz hasło" />
      <Button layoutX="264.0" layoutY="111.0" mnemonicParsing="false" onAction="#savePassword" text="Zapisz" />
      <Button layoutX="111.0" layoutY="111.0" mnemonicParsing="false" onAction="#closeWindow" text="Wyjdź" />
   </children>
</AnchorPane>
