      <PasswordField fx:id="newPassword" layoutX="227.0" layoutY="113.0" />
      <PasswordField fx:id="newPassword2" layoutX="437.0" layoutY="113.0" />
      <Label layoutX="57.0" layoutY="88.0" text="Stare hasło" />
      <Label layoutX="257.0" layoutY="88.0" text="Nowe hasło" />
      <Label layoutX="458.0" layoutY="88.0" text="Powtórz hasło" />
