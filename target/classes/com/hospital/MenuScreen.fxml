<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="456.0" prefWidth="781.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hospital.MenuController">
   <children>
      <Label layoutX="377.0" layoutY="29.0" text="Menu" AnchorPane.topAnchor="29.0" />
      <Button fx:id="addPatientButton" layoutX="14.0" layoutY="76.0" mnemonicParsing="false" onAction="#runAddingPatients" prefHeight="66.0" prefWidth="147.0" text="Dopisz pacjenta" visible="false" AnchorPane.leftAnchor="14.0" />
      <Button fx:id="receiptButton" layoutX="14.0" layoutY="195.0" mnemonicParsing="false" onAction="#runReceipts" prefHeight="66.0" prefWidth="147.0" text="Wypisz receptę" visible="false" AnchorPane.leftAnchor="14.0" />
      <Button fx:id="staffButton" layoutX="620.0" layoutY="76.0" mnemonicParsing="false" onAction="#runStaffManagement" prefHeight="66.0" prefWidth="147.0" text="Dodaj pracownika" visible="false" AnchorPane.rightAnchor="14.0" />
      <Button fx:id="medicalHistoryButton" layoutX="620.0" layoutY="195.0" mnemonicParsing="false" onAction="#runMedicalHistory" prefHeight="66.0" prefWidth="147.0" text="Zobacz Historię Pacjenta" visible="false" AnchorPane.rightAnchor="14.0" />
      <Button fx:id="visitButton" layoutX="14.0" layoutY="307.0" mnemonicParsing="false" onAction="#runVisits" prefHeight="66.0" prefWidth="147.0" text="Umów wizytę" visible="false" AnchorPane.leftAnchor="14.0" />
      <Button fx:id="registerButton" layoutX="620.0" layoutY="307.0" mnemonicParsing="false" onAction="#runRegisteringPatient" prefHeight="66.0" prefWidth="147.0" text="Zarejestruj pacjenta" visible="false" AnchorPane.rightAnchor="14.0" />
