      <Button layoutX="318.0" layoutY="411.0" mnemonicParsing="false" onAction="#tryToLoginAgain" prefHeight="25.0" prefWidth="181.0" text="Zaloguj na innego użytkownika" AnchorPane.bottomAnchor="20.0" />
      <Button fx:id="optionsButton" layoutX="14.0" layoutY="25.0" mnemonicParsing="false" onAction="#runOptions" text="Opcje" />
      <Button layoutX="362.0" layoutY="192.0" mnemonicParsing="false" onAction="#runAppointmentsOnToday" prefHeight="72.0" prefWidth="92.0" text="Wizyty na dziś" />
   </children>
