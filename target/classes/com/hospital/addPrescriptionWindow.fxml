<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hospital.AddPrescriptionController">
   <children>
      <VBox accessibleRole="BUTTON" layoutY="-8.0" prefHeight="400.0" prefWidth="600.0">
         <children>
            <Label alignment="BOTTOM_CENTER" contentDisplay="CENTER" prefHeight="64.0" prefWidth="600.0" text="Dodawanie recept" textAlignment="CENTER" />
            <HBox prefHeight="100.0" prefWidth="200.0">
               <children>
                  <VBox alignment="TOP_CENTER" prefHeight="80.0" prefWidth="600.0" spacing="10.0">
                     <children>
                        <Label alignment="BOTTOM_CENTER" contentDisplay="CENTER" prefHeight="26.0" prefWidth="600.0" text="Pacjent:" textAlignment="CENTER" />
                        <ComboBox fx:id="prescriptionPatient" prefWidth="150.0" />
                     </children>
                     <HBox.margin>
                        <Insets />
                     </HBox.margin>
                  </VBox>
                  <VBox alignment="TOP_CENTER" prefHeight="67.0" prefWidth="600.0" spacing="10.0">
                     <children>
                        <Label alignment="BOTTOM_CENTER" contentDisplay="CENTER" prefHeight="23.0" prefWidth="600.0" text="Dodaj lek:" textAlignment="CENTER" />
                        <ComboBox fx:id="prescriptionMedicaments" prefWidth="150.0" />
                        <Label alignment="BOTTOM_CENTER" contentDisplay="CENTER" prefHeight="23.0" prefWidth="600.0" text="ilość:" textAlignment="CENTER" />
                        <TextField fx:id="medicamentsCount" maxHeight="100.0" maxWidth="100.0" prefHeight="25.0" prefWidth="158.0" />
                        <Button mnemonicParsing="false" onAction="#addMedicament" text="Dodaj" />
                     </children>
                  </VBox>
               </children>
               <padding>
                  <Insets top="10.0" />
               </padding>
            </HBox>
            <TableView fx:id="medicamentsTable" prefHeight="200.0" prefWidth="200.0">
              <columns>
                <TableColumn fx:id="IDColumn" prefWidth="62.0" text="ID" />
                <TableColumn fx:id="medicamentColumn" prefWidth="337.0" text="Lek" />
                  <TableColumn fx:id="typeColumn" minWidth="0.0" prefWidth="79.0" text="Rodzaj" />
                  <TableColumn fx:id="countColumn" minWidth="0.0" prefWidth="82.0" text="Ilość" />
              </columns>
               <VBox.margin>
                  <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
               </VBox.margin>
               <contextMenu>
                  <ContextMenu>
                    <items>
                      <MenuItem mnemonicParsing="false" text="Zmień ilość" />
                    </items>
                  </ContextMenu>
               </contextMenu>
            </TableView>
            <HBox alignment="CENTER" prefHeight="53.0" prefWidth="600.0" spacing="100.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#backMenu" text="Anuluj receptę" />
                  <Button mnemonicParsing="false" onAction="#confirmPrescription" text="Zatwierdź receptę" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
