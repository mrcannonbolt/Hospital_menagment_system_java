<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="770.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hospital.DoctorAppointmentsController">
   <children>
      <Label layoutX="347.0" layoutY="26.0" text="Wizyty na dziś" />
      <TableView fx:id="appointmentsTable" layoutX="85.0" layoutY="70.0" prefHeight="200.0" prefWidth="600.0">
        <columns>
          <TableColumn fx:id="patientColumn" prefWidth="200.0" text="Pacjent" />
          <TableColumn fx:id="dateColumn" prefWidth="200.0" text="Data i godzina" />
            <TableColumn fx:id="descriptionColumn" prefWidth="200.0" text="Opis" />
        </columns>
      </TableView>
      <Button layoutX="451.0" layoutY="325.0" mnemonicParsing="false" onAction="#backMenu" text="Menu" />
      <Button fx:id="refreshAppointments" layoutX="256.0" layoutY="325.0" mnemonicParsing="false" text="Odśwież" />
   </children>
</AnchorPane>
