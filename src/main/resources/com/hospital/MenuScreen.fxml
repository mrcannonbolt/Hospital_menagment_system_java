<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="600.0" maxWidth="1000.0" minHeight="600.0" minWidth="1000.0" prefHeight="600.0" prefWidth="1000.0" styleClass="root" stylesheets="@style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hospital.MenuController">
   <children>
      <VBox prefHeight="600.0" prefWidth="1000.0">
         <children>
            <HBox alignment="CENTER" prefHeight="46.0" prefWidth="1000.0">
               <children>
                  <Label contentDisplay="CENTER" text="Menu" textAlignment="CENTER" HBox.hgrow="ALWAYS" />
               </children>
               <VBox.margin>
                  <Insets />
               </VBox.margin>
            </HBox>
            <HBox prefHeight="100.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
               <children>
                  <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="40.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Button fx:id="addPatientButton" mnemonicParsing="false" onAction="#runAddingPatients" prefHeight="66.0" prefWidth="250.0" text="Dopisz pacjenta" />
                        <Button fx:id="receiptButton" mnemonicParsing="false" onAction="#runAddingPrescription" prefHeight="66.0" prefWidth="250.0" text="Wypisz receptę" />
                        <Button fx:id="staffButton" mnemonicParsing="false" onAction="#runStaffManagement" prefHeight="66.0" prefWidth="250.0" text="Dopisz pracownika" />
                        <Button fx:id="medicalHistoryButton" mnemonicParsing="false" onAction="#runMedicalHistory" prefHeight="66.0" prefWidth="250.0" text="Zmień Dane/Wypisz Pacjenta" />
                     </children>
                  </VBox>
                  <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="40.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Button fx:id="visitButton" mnemonicParsing="false" onAction="#runVisits" prefHeight="66.0" prefWidth="250.0" text="Umów wizytę" />
                        <Button fx:id="registerButton" mnemonicParsing="false" onAction="#runRegisteringPatient" prefHeight="66.0" prefWidth="250.0" text="Zarejestruj pacjenta w szpitalu" />
                        <Button fx:id="PrescriptionButton" mnemonicParsing="false" onAction="#runPrescriptions" prefHeight="66.0" prefWidth="250.0" text="Sprawdź recepty pacjenta" />
                        <Button mnemonicParsing="false" onAction="#runAppointmentsOnToday" prefHeight="66.0" prefWidth="250.0" text="Wizyty na dziś" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            <HBox alignment="CENTER" prefHeight="46.0" prefWidth="1000.0" spacing="80.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#tryToLoginAgain" prefHeight="40.0" prefWidth="300.0" text="Zaloguj na innego użytkownika" />
                  <Button mnemonicParsing="false" onAction="#tryToExitProgram" prefHeight="40.0" text="Wyjdź" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
      <Button fx:id="optionsButton" layoutX="10.0" layoutY="10.0" mnemonicParsing="false" onAction="#runOptions" text="Opcje" />
   </children>
</AnchorPane>
